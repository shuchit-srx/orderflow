COMPOSE_PROJECT_NAME=orderflow

POSTGRES_USER=orderflow
POSTGRES_PASSWORD=orderflow
POSTGRES_PORT=5432

USER_DB_NAME=orderflow_user
INVENTORY_DB_NAME=orderflow_inventory
ORDER_DB_NAME=orderflow_order
NOTIFICATION_DB_NAME=orderflow_notification

REDIS_PORT=6379

RABBITMQ_USERNAME=orderflow
RABBITMQ_PASSWORD=orderflow
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

JWT_ISSUER=orderflow-user-service
JWT_PRIVATE_KEY_HOST_PATH=./user-service/src/main/resources/keys/private.pem
JWT_PUBLIC_KEY_HOST_PATH=./user-service/src/main/resources/keys/public.pem

INTERNAL_SERVICE_TOKEN=local-internal-service-token

API_GATEWAY_PORT=8080
USER_SERVICE_PORT=8081
INVENTORY_SERVICE_PORT=8082
ORDER_SERVICE_PORT=8083
NOTIFICATION_SERVICE_PORT=8084

SPRING_PROFILES_ACTIVE=local